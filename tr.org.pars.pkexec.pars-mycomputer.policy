<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">

<policyconfig>

<vendor>Pars Developers</vendor>
<vendor_url>https://www.pars.org.tr</vendor_url>

  <action id="tr.org.pars.pkexec.pars-mycomputer-fstabwriter">
    <description>Pars My Computer Authentication</description>
    <message>Authentication is required for Pars My Computer</message>
    <message xml:lang="tr">Pars Bilgisayarım için yetkilendirme gerekiyor</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/pars/pars-mycomputer/src/FstabWriter.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
